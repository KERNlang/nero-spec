+func (e *extFlag) schemaValueType() reflect.Type {
+	if e.f == nil {
+		return nil
+	}
+	if _, ok := e.f.Value.(flag.Getter); !ok {
+		return nil
+	}
+	return reflect.TypeOf(e.Get())
+}
+
+func (e *extFlag) SchemaType() string {
+	return schemaTypeFor(e.schemaValueType())
+}
+
+func (e *extFlag) SchemaItemsType() string {
+	return schemaItemsTypeFor(e.schemaValueType())
+}
+
 func (e *extFlag) Names() []string {
 	return []string{e.f.Name}
 }
